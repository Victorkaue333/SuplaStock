# =====================================================
# CONFIGURAÃ‡Ã•ES DE AMBIENTE - suplastock
# =====================================================
# Copie este arquivo para .env e configure as variÃ¡veis

# ============== DJANGO ==============
# Gere uma nova SECRET_KEY com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=sua-secret-key-aqui-gere-uma-nova

# Ambiente: development, staging, production
DJANGO_ENV=development

# Debug (False em produÃ§Ã£o!)
DEBUG=True

# Hosts permitidos (separados por vÃ­rgula)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============== BANCO DE DADOS ==============
# Tipo: sqlite, postgresql, mysql
DATABASE_ENGINE=sqlite

# ConfiguraÃ§Ãµes PostgreSQL (usado quando DATABASE_ENGINE=postgresql)
DATABASE_NAME=suplastock
DATABASE_USER=postgres
DATABASE_PASSWORD=sua-senha-segura
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ============== EMAIL ==============
# Backend: console, smtp
EMAIL_BACKEND=console

# ConfiguraÃ§Ãµes SMTP (usado quando EMAIL_BACKEND=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
DEFAULT_FROM_EMAIL=noreply@vasuplementos.com

# ============== SEGURANÃ‡A ==============
# Ativar HTTPS (True em produÃ§Ã£o!)
SECURE_SSL=False

# ProteÃ§Ã£o de login (anti brute force)
LOGIN_THROTTLE_ENABLED=True
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_MAX_ATTEMPTS_PER_IP=20
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_LOCKOUT_SECONDS=900

# DomÃ­nio para CSRF (ex: .vasuplementos.com)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Upload seguro de imagens de produto
PRODUTO_IMAGE_MAX_BYTES=5242880
PRODUTO_IMAGE_MAX_WIDTH=4096
PRODUTO_IMAGE_MAX_HEIGHT=4096

# ============== CACHE (Redis) ==============
CACHE_BACKEND=dummy
REDIS_URL=redis://localhost:6379/0

# ============== SENTRY (Monitoramento de Erros) ==============
SENTRY_DSN=

# ============== STORAGE ==============
# Tipo: local, s3
STORAGE_BACKEND=local

# AWS S3 (usado quando STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=sa-east-1

